{
  "name": "dentipal-runtime-agents",
  "version": "0.2.0",
  "description": "Thin orchestrator (Professional / Clinic / Public) on AgentCore Runtime, delegating the agent loop to Bedrock Agents. NODE_22, direct S3 code deploy.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf dist && tsc",
    "start:professional": "node dist/professional/index.js",
    "start:clinic": "node dist/clinic/index.js",
    "start:public": "node dist/public/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "bedrock-agentcore": "^0.2.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1045.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1045.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0"
  }
}
